# Environment Variables - Ecossistema Escolar

# 🔹 Node Environment
NODE_ENV=development

# 🔹 Server Configuration
PORT=3000

# 🔹 MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tccecossistemaescolar
DB_PORT=3306

# 🔹 JWT Configuration (para futuro módulo de autenticação)
# JWT_SECRET=seu_secret_key_aqui
# JWT_EXPIRES_IN=24h

# 🔹 Upload Configuration
# MAX_FILE_SIZE=10mb

# 🔹 CORS Configuration
# CORS_ORIGIN=http://localhost:3000

# 🔹 Frontend URL (para links em e-mails)
FRONTEND_URL=http://localhost:3000

# 🔹 Logging Level
# LOG_LEVEL=debug

# 🔹 ============================================
# 🔐 CHAVES DE API EXTERNAS (Serviços de Terceiros)
# 🔹 ============================================

# OpenAI / Azure OpenAI (para recursos de IA)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# Google APIs (Google Classroom, Drive, etc.)
# GOOGLE_CLIENT_ID=xxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini + YouTube Data API v3 (Recomendação de Estudos por IA)
# Podem ser a MESMA chave/projeto Google Cloud, desde que a chave não tenha
# "Restrições de API" limitando a só uma das duas (Console:
# https://console.cloud.google.com/apis/credentials). Na prática, uma chave
# gerada pelo Google AI Studio (aistudio.google.com) já vem restrita só à
# "Generative Language API" — usá-la na YouTube Data API dá 401
# UNAUTHENTICATED "API keys are not supported by this API", mesmo com a API
# habilitada no projeto (confirmado em teste real em 2026-08-04). Por isso o
# projeto usa DUAS variáveis: se YOUTUBE_API_KEY não estiver setada, o código
# cai pra GOOGLE_API_KEY (backend/external/YoutubeDataApiClient.ts).
GOOGLE_API_KEY=
YOUTUBE_API_KEY=

# Ids de modelo do Gemini por tier (opcional — sem isso, usa os aliases
# "-latest" abaixo). O catálogo de modelos da Google muda com frequência;
# se um modelo for descontinuado, corrija aqui sem precisar redeployar
# código. Descubra os ids válidos pra sua chave em:
# https://ai.google.dev/api/models#method:-models.list (ou no seletor de
# modelo do Google AI Studio: https://aistudio.google.com/).
# GEMINI_MODEL_LEVE=gemini-flash-latest
#
# ⚠️ TEMPORÁRIO (2026-08-04): o código já usa gemini-flash-latest como
# fallback pro tier "cheio" também (em vez de gemini-pro-latest), porque a
# chave testada tinha cota ZERO pra modelos Pro no tier gratuito (429
# RESOURCE_EXHAUSTED). Assim que houver billing habilitado no projeto,
# descomente a linha abaixo pra voltar a usar Pro no tier "cheio" (resumo
# grounded e sumário de livro ganham mais fidelidade com Pro):
# GEMINI_MODEL_CHEIO=gemini-pro-latest

# Email Service (Resend - https://resend.com)
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
TEST_EMAIL_TO=bauaecossistemaescolar@gmail.com

# Storage (Cloudflare R2 - compatível com S3)
# Account API Token / User API Token: https://dash.cloudflare.com/ → R2 → Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ecossistema-escolar-uploads
# URL pública do bucket (Public Development URL "pub-xxxx.r2.dev" ou domínio customizado)
R2_PUBLIC_URL=

# Payment Gateway (Stripe, PagSeguro, etc.)
# STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAGSEGURO_EMAIL=seu@email.com
# PAGSEGURO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS Service (Twilio, etc.)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+5511999999999

# Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# MIXPANEL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 🔹 ============================================
# 💡 IMPORTANTE: 
# - Nunca commite o arquivo .env com valores reais
# - Use este .env.example como template
# - Crie seu .env local: cp .env.example .env
# - Adicione suas chaves reais no .env
# 🔹 ============================================
